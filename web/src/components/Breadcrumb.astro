---
type Crumb = { label: string; href?: string };

type Props = {
  items: Crumb[];
};

const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="パンくずリスト">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb {
    max-width: 1080px;
    margin: 0 auto 20px;
    font-size: 14px;
    color: var(--muted);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb li:not(:last-child)::after {
    content: "›";
    margin-left: 8px;
    color: var(--line);
  }

  .breadcrumb a {
    color: var(--link);
    text-decoration: none;
  }
</style>
